# Tests for the textwrap package - offline, deterministic.
import std.test
import "../main.ecko"
tw = main

test.case("wrap breaks text into width-limited lines, preserving words", || {
    lines = tw.wrap("the quick brown fox jumps over", 12)
    for line in lines {
        test.ok(len(line) <= 12, "line within width")
    }
    test.eq(join(lines, " "), "the quick brown fox jumps over")
})

test.case("fill joins wrapped lines with newlines", || {
    test.eq(tw.fill("aaa bbb ccc", 7), "aaa bbb\nccc")
})

test.case("indent prefixes non-blank lines", || {
    test.eq(tw.indent("a\nb", "> "), "> a\n> b")
    test.eq(tw.indent("a\n\nb", "> "), "> a\n\n> b")
})

test.case("dedent removes the common leading whitespace", || {
    test.eq(tw.dedent("    a\n    b"), "a\nb")
    test.eq(tw.dedent("  a\n    b"), "a\n  b")
})

test.case("shorten collapses whitespace and truncates with an ellipsis", || {
    test.eq(tw.shorten("hello world", 20), "hello world")
    test.eq(tw.shorten("hello world foo bar", 12), "hello ...")
})

test.case("whitespace is collapsed by wrap", || {
    test.eq(tw.wrap("a   b\tc", 20), ["a b c"])
})
